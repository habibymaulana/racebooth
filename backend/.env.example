# Copy to .env, generate fresh secrets, keep this file private (chmod 600).
NODE_ENV=development
PORT=3000
# Backend container resolves the existing PostgreSQL container on photobooth-net.
PGHOST=photobooth-postgres
PGPORT=5432
PGDATABASE=photobooth_db
PGUSER=
PGPASSWORD=
# Optional PostgreSQL URL (use a pooled URL for serverless; PG* settings remain the local option).
DATABASE_URL=
# Optional direct connection, used only by the one-off migration runner.
DATABASE_URL_UNPOOLED=
# Use verify-full TLS with a mounted CA when PostgreSQL is configured for TLS.
PGSSL=false
PGSSLROOTCERT=
DATABASE_POOL_MAX=10
SERVERLESS_DEPLOYMENT=false
# Vercel injects VERCEL_URL for each deployment; do not hard-code it.
# Generate independently: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Exactly 32 random bytes encoded as 64 hex chars; protects recoverable issued tokens at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=8
# Comma-separated exact browser origins, no trailing slash; same-origin nginx/Vite proxy.
# Vercel Preview may leave these empty and use its system VERCEL_URL; production must set both explicitly.
APP_ORIGINS=http://localhost:8088,http://localhost:5173
# Set only to the number of trusted reverse proxies when deploying behind HTTPS.
TRUST_PROXY_HOPS=0

# Local development uses a private filesystem directory; Docker compose sets /app/storage.
# Production must use private durable storage and never expose permanent object URLs.
PHOTO_STORAGE_DRIVER=local
PHOTO_STORAGE_PATH=
# R2 credentials are server-only secret-manager values; leave empty for local development.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Vercel connects a private Blob store and injects BLOB_STORE_ID and short-lived OIDC authentication.
BLOB_STORE_ID=
# Optional fallback only; prefer the automatically rotated Vercel OIDC integration.
BLOB_READ_WRITE_TOKEN=
# Cleanup is opt-in; a deployed scheduled route requires a strong independent CRON_SECRET.
PHOTO_CLEANUP_ENABLED=false
PHOTO_CLEANUP_INTERVAL_HOURS=24
CRON_SECRET=
# Gallery/download authorization lasts this many hours beyond capture expiry (no new uploads then).
PHOTO_GALLERY_TTL_HOURS=24
# Read-only QR links expire sooner than the gallery; they cannot capture more photos.
PHOTO_SHARE_TTL_MINUTES=60
# Optional canonical HTTPS origin for QR links. Must also appear in APP_ORIGINS.
# Vercel Preview may derive this from VERCEL_URL; production must set it explicitly.
# Localhost QR works on this Mac; phone access requires a reachable HTTPS deployment.
PUBLIC_APP_ORIGIN=

# Disabled until WF-01 JWT verification and contract have been manually configured and tested.
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://n8n:5678/webhook/photobooth/token/create
N8N_JWT_SECRET=
# Literal template; resolved server-side to the authenticated operator UUID required by WF-01.
N8N_JWT_SUBJECT={operator_id}
N8N_JWT_ISSUER=
N8N_JWT_AUDIENCE=
N8N_JWT_TTL_SECONDS=60
N8N_TIMEOUT_MS=15000

# Free public experience: fixed four accepted photos; historical sales remain.
FREE_SESSION_PHOTO_LIMIT=4
FREE_SESSION_DURATION_MINUTES=120
FREE_SESSION_RATE_LIMIT_PER_IP_PER_HOUR=5

# Existing authenticated email branch. Match its header credential securely in n8n.
# Never copy/export n8n credential values into chat or client-side configuration.
N8N_EMAIL_ENABLED=false
N8N_EMAIL_WEBHOOK_URL=http://n8n:5678/webhook/racebooth/photo-result-email
N8N_EMAIL_WEBHOOK_SECRET=
N8N_EMAIL_TIMEOUT_MS=20000

# Optional Nous Research Hermes API. See docs/hermes-setup.md for the isolated Compose profile.
HERMES_ENDPOINT=
HERMES_API_KEY=
HERMES_API_KEY_FILE=
HERMES_PROVIDER=
HERMES_MODEL=
HERMES_TIMEOUT_MS=5000
HERMES_INFERENCE_ENABLED=false
HERMES_INFERENCE_TIMEOUT_MS=60000
